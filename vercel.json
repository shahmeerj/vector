{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/careers", "destination": "/api/careers" },
    { "source": "/careers/:slug", "destination": "/api/careers?slug=:slug" }
  ],
  "functions": {
    "api/apply.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
